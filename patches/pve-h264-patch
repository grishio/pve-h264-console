     "            text: 'noVNC',\n            iconCls: 'pve-itype-icon-novnc',\n"
     "            type: 'html5',\n            handler: function (button) {\n"
     "                let view = this.up('button');\n                view.openConsole(button.type);\n"
     "            },\n        },\n",
     JS_MENUITEM, "js"),

    ("UI: Console tab uses H.264 when default", MANAGERJS, "after",
     "                    queryDict[type] = 1;\n                    PVE.Utils.cleanEmptyObjectKeys(queryDict);\n",
     "                    if (me.consoleType === 'kvm' && queryDict.novnc && PVE.Utils.h264IsDefault()) {\n"
     "                        delete queryDict.novnc;\n"
     "                        queryDict.h264 = 1;\n"
     "                    }\n",
     "js"),
]

def _pve_version():
    r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "pve-manager"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def _qemu_backends(opt):
    """Backend names QEMU lists for `<opt> help`, or None if it can't be asked.
    (`help` only prints the list and exits; no VM is started.)"""
    try:
        r = subprocess.run([QEMU_BIN, opt, "help"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return {line.strip() for line in r.stdout.splitlines()}


def compat_problems():
    """Reasons this host can't take the integration; empty if it can.

    Fails closed: anything that can't be checked counts as a problem."""
    problems = []
    ver = _pve_version()
    if not ver:
        problems.append("pve-manager is not installed")
    elif subprocess.run(["dpkg", "--compare-versions", ver, "lt", PVE_MIN]).returncode == 0:
        problems.append(f"Proxmox VE {ver} is not supported (needs {PVE_MIN} or newer)")

    for opt in QEMU_NEEDS:
        names = _qemu_backends(opt)
        if names is None:
            problems.append(f"could not run '{QEMU_BIN} {opt} help' to check QEMU")
        elif "dbus" not in names:
            problems.append(f"QEMU ({QEMU_BIN}) has no D-Bus {opt[1:]} backend; "
                            "VMs would fail to start with the qemu-server patch")

    try:
        ac = open(ACCESSCONTROL).read()
    except OSError as e:
        ac = None
        problems.append(f"{ACCESSCONTROL}: {e.strerror}")
    for sub, sig in TICKET_SIGS if ac is not None else ():
        m = re.search(rf"^sub {sub}\b[^{{]*\{{\s*{sig}", ac, re.M)
        if not m:
            problems.append(f"PVE::AccessControl::{sub} has an unexpected signature "
                            "(libpve-access-control too old or changed)")
    return problems


def markers(style):
    return (PERL_BEGIN, PERL_END) if style == "perl" else (JS_BEGIN, JS_END)


def wrap(block, style, name):
    b, e = markers(style)
    indent = re.match(r"\s*", block).group(0) if block.strip() else ""
    indent = indent.split("\n")[-1]
    return f"{indent}{b} {name}\n{block}{indent}{e}\n"


class MarkerError(Exception):
    pass


def strip_blocks(text):
    """Remove our BEGIN..END blocks. Refuses (MarkerError) if the markers are
    not properly paired, instead of guessing and possibly deleting real code
    (e.g. everything after a BEGIN whose END was edited away by hand)."""
    out, skip, begin_line = [], False, 0
    for n, line in enumerate(text.splitlines(keepends=True), 1):
        s = line.strip()
        if s.startswith((PERL_BEGIN, JS_BEGIN)):
            if skip:
                raise MarkerError(f"line {n}: BEGIN inside the block opened at line {begin_line}")
            skip, begin_line = True, n
            continue
        if s.startswith((PERL_END, JS_END)):
            if not skip:
                raise MarkerError(f"line {n}: END without BEGIN")
            skip = False
            continue
        if not skip:
            out.append(line)
    if skip:
        raise MarkerError(f"line {begin_line}: BEGIN without END")
    return "".join(out)


def write_atomic(path, text):
    """Write via temp file + fsync + rename, so the file is never half-written."""
    st = os.stat(path)
    tmp = path + f".{TAG}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, st.st_mode & 0o7777)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.rename(tmp, path)
    dfd = os.open(os.path.dirname(path), os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def marker_help(path, err):
    return (f"{path}: unbalanced {TAG} markers ({err}); file left untouched. "
            "Fix it by hand or restore the package file with "
            "'apt install --reinstall <package>' (see: dpkg -S " + path + ")")


def apply(quiet):
    changed_files = set()
    failed = []
    by_file = {}
    for p in PATCHES:
        by_file.setdefault(p[1], []).append(p)
    for path, plist in by_file.items():
        if not os.path.exists(path):
            failed.append(f"{path}: missing")
            continue
        orig = open(path).read()
        # start from the pristine text so changed blocks are updated in place
        try:
            text = strip_blocks(orig)
        except MarkerError as e:
            failed.append(marker_help(path, e))
            continue
        for name, _, mode, anchor, block, style in plist:
            n = text.count(anchor)
            if n != 1:
                failed.append(f"{name}: anchor found {n}x in {path}")
                continue
            w = wrap(block, style, name)
            text = text.replace(anchor, anchor + w if mode == "after" else w + anchor)
        if text != orig:
            write_atomic(path, text)
            changed_files.add(path)
            if not quiet:
                print(f"patched {path}")
    for f in failed:
        print(f"WARNING: {f}", file=sys.stderr)
    return changed_files, failed


def revert(quiet):
    changed, failed = set(), []
    for path in sorted({p[1] for p in PATCHES}):
        if not os.path.exists(path):
            continue
        orig = open(path).read()
        try:
            text = strip_blocks(orig)
        except MarkerError as e:
            failed.append(marker_help(path, e))
            continue
        if text != orig:
            write_atomic(path, text)
            changed.add(path)
            if not quiet:
                print(f"reverted {path}")
    for f in failed:
        print(f"ERROR: {f}", file=sys.stderr)
    return changed, failed


def status():
    ok = True
    for name, path, _m, _a, _b, style in PATCHES:
        b, _ = markers(style)
        applied = os.path.exists(path) and f"{b} {name}\n" in open(path).read()
        ok &= applied
        print(f"[{'x' if applied else ' '}] {name}  ({path})")
    return ok


def _workers(svc):
    """PIDs of the worker processes of a PVE daemon (children of MainPID)."""
    main = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", svc],
                          capture_output=True, text=True).stdout.strip()
    if not main.isdigit() or main == "0":
        return set()
    try:
        kids = open(f"/proc/{main}/task/{main}/children").read().split()
    except OSError:
        return set()
    return {int(k) for k in kids}


def restart(changed, quiet=False):
    """Reload pvedaemon/pveproxy and WAIT until the old workers are gone.

    `systemctl reload` returns immediately, but the old worker processes keep
    serving requests (with the old code) for several seconds; calls to the
    H.264 API in that window fail with 501 'not implemented'."""
    if not any(p.startswith("/usr/share/perl5/") for p in changed):
        return  # JS only: no restart needed, browsers reload the file
    import time
    for svc in ("pvedaemon", "pveproxy"):
        old = _workers(svc)
        subprocess.run(["systemctl", "reload-or-restart", svc], check=False)
        deadline = time.time() + 30
        while time.time() < deadline:
            alive = {pid for pid in old if os.path.exists(f"/proc/{pid}")}
            new = _workers(svc) - old
            if not alive and new:
                break
            time.sleep(0.25)
        else:
            print(f"WARNING: {svc} workers did not restart within 30 s", file=sys.stderr)
            continue
        if not quiet:
            print(f"{svc}: reloaded ({len(new)} new workers)")


def gpu_check(quiet):
    """If the NVIDIA driver comes from DKMS, every installed kernel needs the
    module built. A kernel installed without its headers silently gets none,
    so NVENC disappears after booting it. (Can't be fixed from inside the apt
    hook - dpkg holds the lock - so tell the admin exactly what to run.)"""
    try:
        st = subprocess.run(["dkms", "status"], capture_output=True, text=True).stdout
    except OSError:
        return True
    if not re.search(r"^nvidia[/,]", st, re.M):
        return True  # no NVIDIA DKMS driver: nothing to check
    ok = True
    for kver in sorted(os.listdir("/lib/modules")):
        if not os.path.exists(f"/boot/vmlinuz-{kver}"):
            continue  # leftover module dir of a removed kernel
        built = re.search(rf"^nvidia[/,][^\n]*\b{re.escape(kver)}\b[^\n]*installed", st, re.M)
        if built:
            continue
        ok = False
        hdr = "" if os.path.exists(f"/lib/modules/{kver}/build") else f"apt install proxmox-headers-{kver} && "
        print(f"pve-h264-console: WARNING kernel {kver} has no NVIDIA module - after booting it NVENC "
              f"is unavailable (H.264 console falls back to CPU). Fix: {hdr}dkms autoinstall -k {kver}",
              file=sys.stderr)
    if ok and not quiet:
        print("NVIDIA DKMS module present for all installed kernels")
    return ok


def main():
    args = sys.argv[1:]
    quiet = "--quiet" in args
    norestart = "--no-restart" in args
    cmd = next((a for a in args if not a.startswith("--")), "status")
    if cmd == "apply":
        problems = compat_problems()
        if problems:
            for p in problems:
                print(f"ERROR: {p}", file=sys.stderr)
            print(f"{TAG}: this host is not supported; nothing applied, "
                  "earlier integration (if any) removed", file=sys.stderr)
            changed, _failed = revert(quiet)
            if not norestart:
                restart(changed, quiet)
            sys.exit(1)
        changed, failed = apply(quiet)
        if not norestart:
            restart(changed, quiet)
        sys.exit(1 if failed else 0)
    elif cmd == "revert":
        changed, failed = revert(quiet)
        if not norestart:
            restart(changed, quiet)
        sys.exit(1 if failed else 0)
    elif cmd == "status":
        ok = status()
        problems = compat_problems()
        for p in problems:
            print(f"ERROR: {p}")
        gpu_check(False)
        sys.exit(0 if ok and not problems else 1)
    elif cmd == "check":
        problems = compat_problems()
        for p in problems:
            print(f"ERROR: {p}", file=sys.stderr)
        if not problems and not quiet:
            print(f"host is supported (Proxmox VE {_pve_version()}, QEMU with D-Bus display)")
        sys.exit(1 if problems else 0)
    elif cmd == "gpu-check":
        sys.exit(0 if gpu_check(quiet) else 1)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
