        my $missing = "pve-h264-console is not installed (or is too old) on node '$node'. "
            . "Install the same version on every cluster node.\n";

        die $missing if !$remote && !-x $ctl;

        my ($token, $err) = ('', '');
        my $rc = eval {
            PVE::Tools::run_command(
                [@$ssh, $ctl, 'prepare', $vmid, $remote ? () : ($authuser)],
                timeout => 45,
                noerr => 1,
                outfunc => sub { $token .= shift },
                errfunc => sub { $err .= shift . "\n" },
            );
        };
        die($@ || "pve-h264-ctl was terminated\n") if !defined($rc);
        die $missing if $remote && $rc == 127; # remote shell: command not found
        die($err || "pve-h264-ctl failed (exit code $rc)\n") if $rc != 0;
        die "pve-h264-ctl returned no token\n" if $token !~ m/^([0-9a-f]{64})$/;
        $token = $1;

        if (!$remote) {
            my $ticket = PVE::AccessControl::assemble_vnc_ticket($authuser, $authpath);
            return { user => $authuser, ticket => $ticket, token => $token };
        }

        # VM on another node: a one-shot relay socket here, for this node's
        # pveproxy, piped to the daemon's socket on $node over SSH
        open(my $rnd, '<', '/dev/urandom') or die "urandom: $!\n";
        sysread($rnd, my $raw, 16) == 16 or die "urandom short read\n";
        close($rnd);
        my ($relay) = unpack('H*', $raw) =~ m/^([0-9a-f]{32})$/; # untaint

        my $gid = getgrnam('www-data') // die "no www-data group\n";
        my $dir = '/run/pve-h264/relay';
        require File::Path;
        File::Path::make_path($dir, { mode => 0700 });
        chmod(0711, '/run/pve-h264');
