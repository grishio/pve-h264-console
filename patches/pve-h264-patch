            my $old = umask(0177); # socket created 0600, opened up to www-data below
            $sock = IO::Socket::UNIX->new(Type => SOCK_STREAM, Local => $path, Listen => 1);
            umask($old);
        }
        die "failed to create relay socket: $!\n" if !$sock;
        if (!chown(0, $gid, $path) || !chmod(0660, $path)) {
            my $e = $!;
            unlink($path);
            die "relay socket permissions: $e\n";
        }

        my $realcmd = sub {
            my $upid = shift;
            syslog('info', "starting H.264 console relay to node '$node' $upid\n");
            my $cli;
            eval {
                alarm(0);
                local $SIG{ALRM} = sub { die "connection timed out\n" };
                alarm(10);
                $cli = $sock->accept();
                alarm(0);
            };
            my $aerr = $@;
            unlink($path);
            close($sock);
            die $aerr if $aerr;
