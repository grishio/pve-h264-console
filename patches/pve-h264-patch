                output => '>&' . fileno($cli),
                input => '<&' . fileno($cli),
                noerr => 1,
            );
            # undef: ssh ended by a signal (uninstall, task stop)
            die "H.264 console relay to node '$node' failed (exit code $rrc)\n"
                if defined($rrc) && $rrc != 0;
            return;
        };

        my $upid = eval { $rpcenv->fork_worker('h264relay', $vmid, $authuser, $realcmd, 1) };
        my $ferr = $@;
        close($sock); # the worker has its own copy
        if ($ferr) {
            unlink($path);
            die $ferr;
