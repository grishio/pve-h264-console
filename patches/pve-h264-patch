     "perl"),

    ("pveproxy: ?console=kvm&h264=1 page", PVEPROXY, "before",
     "    my $page = '';\n    my $template = Template->new({ ABSOLUTE => 1 });\n",
     "    if (defined($args->{console}) && $args->{h264} && -d '/usr/share/pve-h264-console') {\n"
