     "    my $version = PVE::pvecfg::version();\n",
     "    # the UI script is loaded as pvemanagerlib.js?ver=<pve version>, which our\n"
     "    # patch doesn't change, and pveproxy sends no Cache-Control for it: browsers\n"
     "    # would keep running the cached, unpatched copy. Tag it with the file mtime.\n"
     "    if (-d '/usr/share/pve-h264-console') {\n"
