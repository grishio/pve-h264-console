#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""Apply / revert the pve-h264-console integration into Proxmox VE files.

Every change is a pure *insertion* wrapped in BEGIN/END marker lines, anchored
on a unique snippet of the original file. That makes the patcher:
  * idempotent (already-applied blocks are skipped),
  * safe after package upgrades (dpkg restores pristine files, the apt hook
    re-runs `apply`),
  * trivially revertible (`revert` deletes the marked blocks).

If an anchor is not found (Proxmox changed the code), that patch is reported
and skipped; nothing is half-applied.

Before applying, the host is checked (see compat_problems): on an unsupported
Proxmox VE, a QEMU without D-Bus display/audio/chardev, or a ticket API with a
different signature, nothing is applied and blocks left from earlier are
removed, so VMs keep starting and no API runs with the wrong ticket check.

usage: pve-h264-patch apply|revert|status|check|gpu-check [--quiet] [--no-restart]
"""
import os
import re
import subprocess
import sys

TAG = "pve-h264-console"

PERL_BEGIN = f"# {TAG} BEGIN"
PERL_END = f"# {TAG} END"
JS_BEGIN = f"// {TAG} BEGIN"
JS_END = f"// {TAG} END"

QEMUSERVER = "/usr/share/perl5/PVE/QemuServer.pm"
API_QEMU = "/usr/share/perl5/PVE/API2/Qemu.pm"
PVEPROXY = "/usr/share/perl5/PVE/Service/pveproxy.pm"
ANYEVENT = "/usr/share/perl5/PVE/APIServer/AnyEvent.pm"
MANAGERJS = "/usr/share/pve-manager/js/pvemanagerlib.js"
ACCESSCONTROL = "/usr/share/perl5/PVE/AccessControl.pm"

PVE_MIN = "9.0"
# what qemu-server runs for VMs of the host's own architecture
# (PVE::QemuServer::Helpers::get_command_for_arch)
QEMU_BIN = "/usr/bin/kvm"
# backends the qemu-server patch puts on the command line; a QEMU without any
# of them refuses to start the VM
QEMU_NEEDS = ("-display", "-audiodev", "-chardev")
# the API patch passes the relay id as the ticket's 3rd/4th argument ($port).
# Where that slot is something else (e.g. $noerr), a bad ticket would pass.
TICKET_SIGS = (
    ("assemble_vnc_ticket", r"my\s*\(\s*\$username\s*,\s*\$path\s*,\s*\$port\s*\)\s*=\s*@_\s*;"),
    ("verify_vnc_ticket",
     r"my\s*\(\s*\$ticket\s*,\s*\$username\s*,\s*\$path\s*,\s*\$port\s*,\s*\$noerr\s*\)\s*=\s*@_\s*;"),
)

API_METHODS = r'''
__PACKAGE__->register_method({
    name => 'h264proxy',
    path => '{vmid}/h264proxy',
    method => 'POST',
    protected => 1,
    # no proxyto: like vncproxy this runs on the node the browser is connected
