     "perl"),

    ("API: h264proxy + h264websocket", API_QEMU, "before",
     "__PACKAGE__->register_method({\n    name => 'spiceproxy',\n",
     API_METHODS, "perl"),

    ("pveproxy: serve /h264/", PVEPROXY, "after",
     "    add_dirs($dirs, '/xtermjs/' => \"$basedirs->{xtermjs}/\");\n",
     "    add_dirs($dirs, '/h264/' => '/usr/share/pve-h264-console/')\n"
     "        if -d '/usr/share/pve-h264-console';\n",
     "perl"),

