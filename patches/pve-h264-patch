# (file, mode, anchor, block, comment-style)
#   mode 'after'  -> insert block right after anchor
#   mode 'before' -> insert block right before anchor
PATCHES = [
    # Guest audio: the VM's audio0 backend (default 'spice') becomes QEMU's
    # D-Bus backend, handed to the D-Bus display, where pve-h264d picks it up
    # (daemon/audio.c). 'driver=none' is left alone; 'audio = 0' in
    # /etc/pve-h264/h264d.conf keeps audio on SPICE (remote-viewer) instead.
    # timer-period=5000: QEMU mixes at most one 480-frame (10 ms) D-Bus buffer
    # per audio timer tick, and the timer re-arms 10 ms after each run ends, so
    # with the default 10 ms period the guest's sound came out ~2-3 % slow
    # (46.8 kHz measured, worse under host CPU load). A 5 ms tick leaves room;
    # QEMU's rate control still holds it to real time.
    ("qemu-server: add -display dbus,p2p=yes", QEMUSERVER, "after",
     "        push @$cmd, '-vnc', \"unix:$socket,password=on\";\n",
     "        if ($vga->{type} ne 'virtio-gl' && ($conf->{args} // '') !~ m/-display\\b/) {\n"
     "            my $display = 'dbus,p2p=yes';\n"
     "            my $h264_audio = 1;\n"
     "            if (open(my $fh, '<', '/etc/pve-h264/h264d.conf')) {\n"
     "                while (my $l = <$fh>) { $h264_audio = $1 if $l =~ m/^\\s*audio\\s*=\\s*(\\d+)/; }\n"
     "                close($fh);\n"
     "            }\n"
     "            for (my $i = 0; $h264_audio && $i < $#$devices; $i++) {\n"
     "                next if $devices->[$i] ne '-audiodev'\n"
     "                    || $devices->[$i + 1] !~ m/^spice,id=([\\w-]+)$/;\n"
     "                $devices->[$i + 1] = \"dbus,id=$1,timer-period=5000,out.frequency=48000,out.channels=2\";\n"
     "                $display .= \",audiodev=$1\";\n"
     "                last;\n"
     "            }\n"
     "            push @$cmd, '-display', $display;\n"
     "        }\n",
     "perl"),

    # The spice agent port normally goes to the SPICE server, which turns
    # monitor configs into the same SetUIInfo hint the Windows virtio-gpu driver
    # ignores. On a D-Bus chardev pve-h264d talks to the agent itself and sends
    # the resolution to it directly (see daemon/vdagent.c).
    ("qemu-server: spice agent port on D-Bus", QEMUSERVER, "after",
     "        push @$devices, '-device', \"virtserialport,chardev=vdagent,name=com.redhat.spice.0\";\n",
     "        if ($vga->{type} ne 'virtio-gl' && ($conf->{args} // '') !~ m/-display\\b/) {\n"
     "            s/^spicevmc,id=vdagent,name=vdagent$/dbus,id=vdagent,name=com.redhat.spice.0/\n"
     "                for @$devices;\n"
