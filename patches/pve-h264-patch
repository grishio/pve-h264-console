        # cluster SSH, as vncproxy uses for remote VMs; only the vmid goes into
        # the remote command line (ssh hands it to a shell)
        my $ssh = $remote
            ? PVE::SSHInfo::ssh_info_to_command(PVE::SSHInfo::get_ssh_info($node), '-T')
